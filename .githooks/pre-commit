#!/bin/sh

MARKER_A="TO""DO"
MARKER_B="FIX""ME"

echo "Checking all staged files for unfinished markers..."

if git grep --cached -I -n -E "${MARKER_A}|${MARKER_B}" -- .; then
    echo "ERROR: Staged files contain unfinished markers."
    echo "Commit rejected."
    exit 1
fi

echo "Pre-commit check passed."
exit 0
